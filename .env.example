# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env.local and update with your values.
# Never commit .env.local or any file containing real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# For local development, run `supabase start` and use the values from
# `supabase status`. The URL and anon key will be displayed in the output.
#
# For production, get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api

# Supabase API URL
# Local: http://127.0.0.1:54321
# Production: https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous Key (safe to expose in client apps)
# Get from `supabase status` or Supabase dashboard
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER expose in client apps!)
# Only use in server-side code or scripts
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------

# Environment: development | staging | production
APP_ENV=development
