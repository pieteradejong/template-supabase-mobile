#
# Copy this file to: apps/mobile/.env.local
#
# Hosted Supabase (recommended):
# - Copy these from your Supabase Dashboard → Project Settings → API
#
# IMPORTANT:
# - These are intended to be public (anon key), safe to ship in the client.
# - Do NOT put your service role key here.
#

# Supabase Configuration (required)
EXPO_PUBLIC_SUPABASE_URL=__REPLACE_ME__
EXPO_PUBLIC_SUPABASE_ANON_KEY=__REPLACE_ME__

# App Configuration (optional - defaults are in app.config.ts)
# Uncomment and customize these to override defaults:
# APP_NAME=My App
# APP_SLUG=my-app
# APP_SCHEME=myapp
# APP_IOS_BUNDLE_ID=com.yourcompany.yourapp
# APP_ANDROID_PACKAGE=com.yourcompany.yourapp

APP_ENV=development
