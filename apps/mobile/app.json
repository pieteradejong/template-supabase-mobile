{
  "expo": {
    "name": "Template App",
    "slug": "template-app",
    "version": "1.0.0",
    "scheme": "template",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.example.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
